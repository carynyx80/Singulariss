# SINGULARIS env — copy to .env.local (never commit secrets)
# Frontend may ONLY use NEXT_PUBLIC_ values.

# --- Chain selection ---
# local | robinhood-testnet | robinhood-mainnet | bsc-testnet | bsc-mainnet
NEXT_PUBLIC_ACTIVE_CHAIN=robinhood-testnet

# --- Robinhood Chain (verified 2026-10-15 via https://docs.robinhood.com/chain/connecting) ---
# Mainnet chain ID 4663, testnet 46630, gas ETH
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_MAINNET_EXPLORER=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_ROBINHOOD_TESTNET_EXPLORER=https://explorer.testnet.chain.robinhood.com

# --- BNB Smart Chain (verified 2026-10-15 via https://docs.bnbchain.org) ---
# Mainnet 56, testnet 97. Target is BNB Smart Chain, NOT opBNB.
NEXT_PUBLIC_BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_MAINNET_EXPLORER=https://bscscan.com
NEXT_PUBLIC_BSC_TESTNET_EXPLORER=https://testnet.bscscan.com

# --- Deployed vault addresses (empty until testnet deploy with explicit approval) ---
NEXT_PUBLIC_VAULT_ROBINHOOD_TESTNET=
NEXT_PUBLIC_VAULT_BSC_TESTNET=
NEXT_PUBLIC_VAULT_ROBINHOOD_MAINNET=
NEXT_PUBLIC_VAULT_BSC_MAINNET=

# --- WalletConnect (optional for RainbowKit) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Server only (never NEXT_PUBLIC_) ---
# DEPLOYER_PRIVATE_KEY=
# ALCHEMY_API_KEY=
